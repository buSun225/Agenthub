{
  "name": "agenthub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node scripts/dev.mjs",
    "dev:api": "node server/index.mjs",
    "dev:web": "npm run build && node server/static.mjs",
    "build": "tsc -b && vite build --configLoader runner",
    "preview": "node node_modules/vite/bin/vite.js preview --host 127.0.0.1 --configLoader runner",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.1.12",
    "typescript": "^5.9.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9"
  }
}
