VITE_AGENTHUB_API_URL=http://127.0.0.1:8787

# Provider can be openai, aigo, or fallback.
AGENTHUB_LLM_PROVIDER=aigo
AGENTHUB_LLM_MODEL=gpt-5.5
AGENTHUB_LLM_FALLBACK_MODEL=gpt-5.4-mini
AGENTHUB_REASONING_EFFORT=low
AGENTHUB_MAX_OUTPUT_TOKENS=900

# Aigo provider. The Codex-compatible endpoint uses /responses from the root base URL.
AIGO_API_KEY=
AIGO_BASE_URL=https://api.aigocode.com
AIGO_MODEL=gpt-5.3-codex
# Use responses for /responses. Aigo keys must be enabled for third-party/API access.
AIGO_API_STYLE=responses

# OpenAI provider.
OPENAI_API_KEY=
AGENTHUB_OPENAI_MODEL=gpt-5.5
AGENTHUB_OPENAI_FALLBACK_MODEL=gpt-5.4-mini
